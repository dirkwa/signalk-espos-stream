{
  "name": "signalk-espos-stream",
  "version": "0.1.0",
  "description": "Streams a browser-rendered Signal K dashboard to an espOS panel as ACK-paced MJPEG with a touch backchannel, running the capture chain (Xvfb + Chromium + ffmpeg) in a managed container.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public",
    "icon.svg",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc && webpack",
    "test": "npm run typecheck:test && npm run typecheck:panel && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "typecheck:panel": "tsc --noEmit --project tsconfig.panel.json",
    "prettier": "prettier --write .",
    "lint": "eslint --fix",
    "format": "npm run prettier && npm run lint",
    "ci-lint": "eslint && prettier --check .",
    "build-image": "scripts/build-image.sh",
    "release": "git tag -d v$npm_package_version; git tag v$npm_package_version && git push && git push origin v$npm_package_version",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin-configurator",
    "signalk-category-utility",
    "espos",
    "esp32-p4",
    "mjpeg",
    "streaming",
    "kiosk",
    "marine"
  ],
  "author": "Dirk Wahrheit",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkwa/signalk-espos-stream.git"
  },
  "signalk": {
    "displayName": "espOS Display Stream",
    "appIcon": "./icon.svg",
    "requires": [
      "signalk-container"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "signalk-container-helper": "^0.11.0",
    "typebox": "^1.3.25"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@signalk/server-api": "^2.31.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.4",
    "babel-loader": "^10.1.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.10",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2",
    "zustand": "^5.0.15"
  }
}
